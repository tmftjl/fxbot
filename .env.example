# 复制为 .env 后按需修改（docker compose 会自动读取）。

# host 网络模式下 fxbot 直接监听宿主机地址，不再做端口映射。
# 默认仅本机可访问；需要让远程 NapCat 连接时改成 0.0.0.0，并务必配置 token。
FXBOT_BIND=127.0.0.1
# 直接占用宿主机端口。
FXBOT_PORT=8683

# 日志与时区
TZ=Asia/Shanghai

# 容器运行身份：默认 0:0，是固定的 root，不会自动跟随宿主机用户。
# root 服务器上用它最省事：容器内 #更新 和手动 git pull 的属主一致，不需要 chown。
# 用普通用户部署时请显式填成 `id -u`:`id -g` 的结果，否则容器更新会留下 root 属主的文件。
# 改动后需保证 ./ 和 ./data（含 .git）都归该 uid/gid 所有。
# FXBOT_UID=0
# FXBOT_GID=0

# 构建期 apt 源，默认 deb.debian.org（官方源）。
# 只在「不走代理且直连慢」时才需要换，可选：
# APT_MIRROR=mirrors.cloud.tencent.com
# APT_MIRROR=mirrors.aliyun.com
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# 换源后需要重新构建才会生效。

# PyPI 源，默认官方 pypi.org。不走代理时可换：
# PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# PYPI_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
# PYPI_INDEX=https://mirrors.aliyun.com/pypi/simple
# 换源会在构建时用新源重新锁定一次 uv.lock（版本不变，只改下载地址）。

# 构建期 Chromium 下载地址。默认官方 CDN 直连；国内建议挂代理，
# 不推荐第三方镜像源，一般留空即可。
# PLAYWRIGHT_DOWNLOAD_HOST=

# 可选：使用宿主机上的本地 mihomo / Clash（构建期和运行期都生效）。
# compose 使用 network_mode: host，容器里的 127.0.0.1 就是宿主机。
# 需要 mihomo 监听 127.0.0.1:7890；端口以你的实际配置为准。
# PROXY_URL=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
