# 复制为 .env 后按需修改（docker compose 会自动读取）。

# host 网络模式下 fxbot 直接监听宿主机地址，不再做端口映射。
# 默认仅本机可访问；需要让远程 NapCat 连接时改成 0.0.0.0，并务必配置 token。
FXBOT_BIND=127.0.0.1
# 直接占用宿主机端口。
FXBOT_PORT=8683

# 日志与时区
TZ=Asia/Shanghai

# 可选：使用宿主机上的本地 mihomo / Clash（构建期和运行期都生效）。
# compose 使用 network_mode: host，容器里的 127.0.0.1 就是宿主机。
# 需要 mihomo 监听 127.0.0.1:7890；端口以你的实际配置为准。
# PROXY_URL=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
